<%- include('partials/head', { title: 'My Tasks' }) %>
<%- include('partials/nav', { currentUser }) %>
<%- include('partials/alerts', { error }) %>

<div class="page-header">
    <div>
        <h1>My Tasks</h1>
        <p class="subtitle">Your personal todo list</p>
    </div>
    <a href="/todo/new" class="btn btn-primary">+ New Task</a>
</div>

<% if (todos.length === 0) { %>
    <div class="card empty-state">
        <p>No tasks yet. Create your first one!</p>
        <a href="/todo/new" class="btn btn-primary">Create Task</a>
    </div>
<% } else { %>
    <ul class="todo-list">
        <% todos.forEach(todo => { %>
            <li class="todo-item">
                <span class="todo-title <%= todo.completed ? 'done' : '' %>">
                    <%= todo.title %>
                </span>
                <div class="todo-actions">
                    <a href="/todo/<%= todo._id %>/more" class="btn btn-ghost btn-sm">View</a>
                    <a href="/todo/<%= todo._id %>/edit" class="btn btn-ghost btn-sm">Edit</a>
                    <form action="/todo/<%= todo._id %>/delete?_method=DELETE" method="POST">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </div>
            </li>
        <% }) %>
    </ul>
<% } %>

<%- include('partials/footer') %>
