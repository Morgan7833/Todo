<%- include('partials/head', { title: 'New Task' }) %>
<%- include('partials/nav', { currentUser }) %>

<div class="card">
    <h1>New Task</h1>
    <p class="subtitle">Add a new item to your list</p>
    <%- include('partials/alerts', { error }) %>

    <form action="/todo" method="POST">
        <div class="form-group">
            <label for="title">Title</label>
            <input type="text" id="title" name="title" placeholder="What needs to be done?"
                value="<%= typeof values !== 'undefined' && values.title ? values.title : '' %>" required>
        </div>
        <div class="form-group">
            <label for="description">Description</label>
            <input type="text" id="description" name="description" placeholder="Add more details"
                value="<%= typeof values !== 'undefined' && values.description ? values.description : '' %>" required>
        </div>
        <div class="form-group checkbox-group">
            <input type="checkbox" id="completed" name="completed"
                <%= typeof values !== 'undefined' && values.completed ? 'checked' : '' %>>
            <label for="completed" style="margin:0">Mark as completed</label>
        </div>
        <div class="actions-row">
            <button type="submit" class="btn btn-primary">Save Task</button>
            <a href="/todo" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>

<%- include('partials/footer') %>
